# Copy to .env and fill in real values. NEVER commit .env.
# In production set these in Render > Environment instead.

APP_NAME=Community AI Platform
APP_URL=https://communityai.co.in
COMPANY_NAME=Community AI
# Must be false in production (true exposes /docs and /openapi.json).
DEBUG=false

# JWT signing key: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# JSON list of allowed browser origins
ALLOWED_ORIGINS=["https://communityai.co.in","http://localhost:5173"]
# Reverse proxies in front of the app that append to X-Forwarded-For (Render: 1)
TRUSTED_PROXY_HOPS=1

# Database: Turso (libsql://<db>.turso.io?authToken=<token>) or postgres://...
DATABASE_URL=libsql://your-db.turso.io?authToken=your-token
OLD_DATABASE_URL=

# Google sign-in (public client ID, same as the frontend's)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email
BREVO_API_KEY=
SENDER_EMAIL=
ADMIN_EMAIL=

# AI / data providers
GROQ_API_KEY=
GEMINI_API_KEY=
NEWS_API_KEY=
YOUTUBE_API_KEY=
PIB_RSS_URL=

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_Q_APPLICATION_ID=
