{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.communityai.co.in" }],
            "destination": "https://communityai.co.in/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(login|register|forgot-password|admin-login|dashboard|assistant|resources|learning|profile|feedback|forum|admin)",
            "destination": "/app"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        },
        {
            "source": "/(login|register|forgot-password|admin-login|dashboard|assistant|resources|learning|profile|feedback|forum|admin)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                },
                {
                    "key": "Cache-Control",
                    "value": "private, no-store"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
